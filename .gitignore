# ============================================================
# ML Models
# Trained binary models are not committed by default.
# ============================================================

models/*.pkl
models/*.joblib
models/*.pt
models/*.onnx

# Keep directory placeholders
!models/**/.gitkeep

# ============================================================
# Data
# Synthetic datasets are intentionally TRACKED for
# reproducible ML development and evaluation.
#
# Do NOT add data/*.csv here.
# ============================================================

# Keep directory placeholders
!data/**/.gitkeep

# ============================================================
# Logs / Temporary Files
# ============================================================

*.log
*.tmp
*.temp

